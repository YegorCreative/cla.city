generator client {
  provider = "prisma-client-js"
  output   = "../workers/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Contact {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100)
  email       String   @db.VarChar(320)
  message     String   @db.VarChar(3000)
  category    String   @db.VarChar(32)
  language    String   @db.VarChar(2)
  page        String   @db.VarChar(32)
  status      String   @default("New") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")
  prayerRequest PrayerRequest?
  visitor Visitor?
  volunteer Volunteer?
  followUpTasks FollowUpTask[]

  @@index([createdAt])
  @@index([category])
  @@index([email])
  @@index([status])
  @@map("contacts")
}

model Visitor {
  id                   String   @id @default(uuid()) @db.Uuid
  contactId            String   @unique @map("contact_id") @db.Uuid
  contact              Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  name                 String   @db.VarChar(100)
  email                String   @db.VarChar(320)
  phone                String?  @db.VarChar(32)
  language             String   @db.VarChar(2)
  visitDate            DateTime? @map("visit_date")
  status               String   @default("Planned") @db.VarChar(32)
  welcomeAssignedTo    String?  @map("welcome_assigned_to") @db.VarChar(100)
  followUpDate         DateTime? @map("follow_up_date")
  notes                String?  @db.VarChar(3000)
  @@index([status])
  @@index([createdAt])
  @@map("visitors")
}

model Volunteer {
  id               String   @id @default(uuid()) @db.Uuid
  contactId        String   @unique @map("contact_id") @db.Uuid
  contact          Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  firstName        String   @db.VarChar(100)
  lastName         String?  @db.VarChar(100)
  email            String   @db.VarChar(320)
  phone            String?  @db.VarChar(32)
  language         String   @db.VarChar(2)
  ministry        String   @db.VarChar(40)
  status           String   @default("Applied") @db.VarChar(32)
  experience       String?  @db.VarChar(3000)
  availability     String?  @db.VarChar(1000)
  backgroundCheck  Boolean  @default(false) @map("background_check")
  notes            String?  @db.VarChar(3000)
  assignedLeader   String?  @map("assigned_leader") @db.VarChar(100)
  @@index([status])
  @@index([ministry])
  @@index([language])
  @@index([createdAt])
  @@map("volunteers")
}

model FollowUpTask {
  id             String   @id @default(uuid()) @db.Uuid
  contactId      String   @db.Uuid
  contact        Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedUserId String?  @map("assigned_user_id") @db.Uuid
  assignedUser   User?    @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  title          String   @db.VarChar(160)
  description    String?  @db.VarChar(3000)
  dueDate        DateTime @map("due_date")
  priority       String   @default("Normal") @db.VarChar(16)
  status         String   @default("Open") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  completedAt    DateTime? @map("completed_at")
  @@index([contactId])
  @@index([assignedUserId])
  @@index([status])
  @@index([dueDate])
  @@map("follow_up_tasks")
}

model PrayerRequest {
  id           String   @id @default(uuid()) @db.Uuid
  contactId    String   @unique @map("contact_id") @db.Uuid
  contact      Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  name         String   @db.VarChar(100)
  email        String   @db.VarChar(320)
  request      String   @db.VarChar(3000)
  language     String   @db.VarChar(2)
  status       String   @default("New") @db.VarChar(20)
  assignedTo   String?  @map("assigned_to") @db.Uuid
  private      Boolean  @default(true)
  answered     Boolean  @default(false)
  answeredDate DateTime? @map("answered_date")
  notes        String?  @db.VarChar(3000)
  @@index([status])
  @@index([createdAt])
  @@map("prayer_requests")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(320)
  passwordHash String    @map("password_hash")
  role         String    @db.VarChar(32)
  sessions     Session[]
  assignedTasks FollowUpTask[]
  createdAt    DateTime  @default(now()) @map("created_at")
  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash")
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([expiresAt])
  @@map("sessions")
}
