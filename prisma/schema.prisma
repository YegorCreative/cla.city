generator client {
  provider = "prisma-client-js"
  output   = "../workers/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Contact {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100)
  email       String   @db.VarChar(320)
  message     String   @db.VarChar(3000)
  category    String   @db.VarChar(32)
  language    String   @db.VarChar(2)
  page        String   @db.VarChar(32)
  status      String   @default("New") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")
  prayerRequest PrayerRequest?

  @@index([createdAt])
  @@index([category])
  @@map("contacts")
}

model PrayerRequest {
  id           String   @id @default(uuid()) @db.Uuid
  contactId    String   @unique @map("contact_id") @db.Uuid
  contact      Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  name         String   @db.VarChar(100)
  email        String   @db.VarChar(320)
  request      String   @db.VarChar(3000)
  language     String   @db.VarChar(2)
  status       String   @default("New") @db.VarChar(20)
  assignedTo   String?  @map("assigned_to") @db.Uuid
  private      Boolean  @default(true)
  answered     Boolean  @default(false)
  answeredDate DateTime? @map("answered_date")
  notes        String?  @db.VarChar(3000)
  @@index([status])
  @@index([createdAt])
  @@map("prayer_requests")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(320)
  passwordHash String    @map("password_hash")
  role         String    @db.VarChar(32)
  sessions     Session[]
  createdAt    DateTime  @default(now()) @map("created_at")
  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash")
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([expiresAt])
  @@map("sessions")
}
