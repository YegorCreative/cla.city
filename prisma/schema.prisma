generator client {
  provider = "prisma-client-js"
  output   = "../workers/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Contact {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100)
  email       String   @db.VarChar(320)
  message     String   @db.VarChar(3000)
  category    String   @db.VarChar(32)
  language    String   @db.VarChar(2)
  page        String   @db.VarChar(32)
  status      String   @default("New") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")
  prayerRequest PrayerRequest?
  visitor Visitor?
  volunteer Volunteer?
  followUpTasks FollowUpTask[]
  registrations EventRegistration[]
  communications Communication[]

  @@index([createdAt])
  @@index([category])
  @@index([email])
  @@index([status])
  @@map("contacts")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  module     String   @db.VarChar(60)
  entityType String   @map("entity_type") @db.VarChar(60)
  entityId   String?  @map("entity_id") @db.VarChar(80)
  action     String   @db.VarChar(80)
  beforeData Json?    @map("before_data")
  afterData  Json?    @map("after_data")
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at")
  @@index([createdAt])
  @@index([module])
  @@index([action])
  @@index([userId])
  @@map("audit_logs")
}

model WorkflowExecution {
  id           String   @id @default(uuid()) @db.Uuid
  workflowType String   @map("workflow_type") @db.VarChar(80)
  trigger      String   @db.VarChar(80)
  entityType   String   @map("entity_type") @db.VarChar(60)
  entityId     String   @map("entity_id") @db.VarChar(80)
  status       String   @db.VarChar(20)
  startedAt    DateTime @map("started_at")
  completedAt  DateTime? @map("completed_at")
  error        String?  @db.VarChar(2000)
  @@unique([trigger, entityType, entityId])
  @@index([startedAt])
  @@index([status])
  @@map("workflow_executions")
}

model PlatformSettings {
  id                 String   @id @default(uuid()) @db.Uuid
  churchName         String?
  churchShortName    String?
  websiteUrl         String?
  contactEmail       String?
  phone              String?
  address            String?
  timezone           String?
  defaultLanguage    String?  @db.VarChar(2)
  supportedLanguages Json?
  logoUrl            String?
  faviconUrl         String?
  primaryColor       String?
  secondaryColor     String?
  footerText         String?
  facebookUrl        String?
  instagramUrl       String?
  youtubeUrl         String?
  giveUrl            String?
  serviceTimes       Json?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  updatedByUserId    String?  @map("updated_by_user_id") @db.Uuid
  @@map("platform_settings")
}

model Communication {
  id           String   @id @default(uuid()) @db.Uuid
  contactId    String   @db.Uuid
  authorUserId String   @db.Uuid
  contact      Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  author       User     @relation(fields: [authorUserId], references: [id])
  type         String   @default("Email") @db.VarChar(16)
  subject      String   @db.VarChar(200)
  body         String   @db.VarChar(10000)
  status       String   @default("Draft") @db.VarChar(16)
  sentAt       DateTime? @map("sent_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  @@index([contactId])
  @@index([status])
  @@index([subject])
  @@map("communications")
}

model ContentPage {
  id             String   @id @default(uuid()) @db.Uuid
  slug           String   @db.VarChar(80)
  language       String   @db.VarChar(2)
  title          String   @db.VarChar(180)
  content        Json
  published      Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  updatedByUserId String? @map("updated_by_user_id") @db.Uuid
  @@unique([slug, language, published])
  @@index([slug, language])
  @@map("content_pages")
}

model Event {
  id                   String   @id @default(uuid()) @db.Uuid
  title                String   @db.VarChar(180)
  slug                 String   @unique @db.VarChar(200)
  description          String   @db.VarChar(5000)
  location             String   @db.VarChar(240)
  startDate            DateTime @map("start_date")
  endDate              DateTime @map("end_date")
  capacity             Int?
  registrationEnabled  Boolean  @default(true) @map("registration_enabled")
  isPublished          Boolean  @default(false) @map("is_published")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  registrations        EventRegistration[]
  @@index([startDate])
  @@index([isPublished])
  @@map("events")
}

model EventRegistration {
  id           String   @id @default(uuid()) @db.Uuid
  eventId      String   @db.Uuid
  contactId    String   @db.Uuid
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  contact      Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  registeredAt DateTime @default(now()) @map("registered_at")
  status       String   @default("Registered") @db.VarChar(20)
  notes        String?  @db.VarChar(2000)
  @@unique([eventId, contactId])
  @@index([eventId])
  @@index([contactId])
  @@map("event_registrations")
}

model Visitor {
  id                   String   @id @default(uuid()) @db.Uuid
  contactId            String   @unique @map("contact_id") @db.Uuid
  contact              Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  name                 String   @db.VarChar(100)
  email                String   @db.VarChar(320)
  phone                String?  @db.VarChar(32)
  language             String   @db.VarChar(2)
  visitDate            DateTime? @map("visit_date")
  status               String   @default("Planned") @db.VarChar(32)
  welcomeAssignedTo    String?  @map("welcome_assigned_to") @db.VarChar(100)
  followUpDate         DateTime? @map("follow_up_date")
  notes                String?  @db.VarChar(3000)
  @@index([status])
  @@index([createdAt])
  @@map("visitors")
}

model Volunteer {
  id               String   @id @default(uuid()) @db.Uuid
  contactId        String   @unique @map("contact_id") @db.Uuid
  contact          Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  firstName        String   @db.VarChar(100)
  lastName         String?  @db.VarChar(100)
  email            String   @db.VarChar(320)
  phone            String?  @db.VarChar(32)
  language         String   @db.VarChar(2)
  ministry        String   @db.VarChar(40)
  status           String   @default("Applied") @db.VarChar(32)
  experience       String?  @db.VarChar(3000)
  availability     String?  @db.VarChar(1000)
  backgroundCheck  Boolean  @default(false) @map("background_check")
  notes            String?  @db.VarChar(3000)
  assignedLeader   String?  @map("assigned_leader") @db.VarChar(100)
  @@index([status])
  @@index([ministry])
  @@index([language])
  @@index([createdAt])
  @@map("volunteers")
}

model FollowUpTask {
  id             String   @id @default(uuid()) @db.Uuid
  contactId      String   @db.Uuid
  contact        Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedUserId String?  @map("assigned_user_id") @db.Uuid
  assignedUser   User?    @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  title          String   @db.VarChar(160)
  description    String?  @db.VarChar(3000)
  dueDate        DateTime @map("due_date")
  priority       String   @default("Normal") @db.VarChar(16)
  status         String   @default("Open") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  completedAt    DateTime? @map("completed_at")
  @@index([contactId])
  @@index([assignedUserId])
  @@index([status])
  @@index([dueDate])
  @@map("follow_up_tasks")
}

model PrayerRequest {
  id           String   @id @default(uuid()) @db.Uuid
  contactId    String   @unique @map("contact_id") @db.Uuid
  contact      Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  name         String   @db.VarChar(100)
  email        String   @db.VarChar(320)
  request      String   @db.VarChar(3000)
  language     String   @db.VarChar(2)
  status       String   @default("New") @db.VarChar(20)
  assignedTo   String?  @map("assigned_to") @db.Uuid
  private      Boolean  @default(true)
  answered     Boolean  @default(false)
  answeredDate DateTime? @map("answered_date")
  notes        String?  @db.VarChar(3000)
  @@index([status])
  @@index([createdAt])
  @@map("prayer_requests")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(320)
  passwordHash String    @map("password_hash")
  role         String    @db.VarChar(32)
  sessions     Session[]
  assignedTasks FollowUpTask[]
  communications Communication[]
  createdAt    DateTime  @default(now()) @map("created_at")
  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash")
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([expiresAt])
  @@map("sessions")
}
